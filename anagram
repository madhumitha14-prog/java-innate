import java.util.Scanner;

public class AnagramChecker {
    public static boolean isAnagram(String str1, String str2) {
        // Remove all whitespaces and convert to lowercase for case-insensitivity
        str1 = str1.replaceAll("\\s", "").toLowerCase();
        str2 = str2.replaceAll("\\s", "").toLowerCase();

        // If lengths are different, they cannot be anagrams
        if (str1.length() != str2.length()) {
            return false;
        }

        // Initialize tracking array for all 256 standard ASCII characters
        int[] charCounts = new int[256];

        // Track frequencies: increment for str1, decrement for str2
        for (int i = 0; i < str1.length(); i++) {
            charCounts[str1.charAt(i)]++;
            charCounts[str2.charAt(i)]--;
        }

        // Check if all counts returned to zero
        for (int count : charCounts) {
            if (count != 0) {
                return false;
            }
        }

        return true;
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.print("Enter first string: ");
        String first = scanner.nextLine();

        System.out.print("Enter second string: ");
        String second = scanner.nextLine();

        if (isAnagram(first, second)) {
            System.out.println('"' + first + "\" and \"" + second + "\" are anagrams.");
        } else {
            System.out.println('"' + first + "\" and \"" + second + "\" are NOT anagrams.");
        }

        scanner.close();
    }
}
